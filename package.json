{
  "name": "wewillfind-it",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run images && next dev",
    "build": "npm run images && next build",
    "start": "next start",
    "lint": "eslint",
    "images": "node scripts/sync-images.mjs",
    "typecheck": "tsc --noEmit",
    "build:dev": "node scripts/build-static.mjs dev",
    "build:prod": "node scripts/build-static.mjs prod",
    "preview": "wrangler dev",
    "deploy:dev": "npm run build:dev && wrangler deploy --env dev",
    "deploy:prod": "npm run build:prod && wrangler deploy --env prod",
    "deploy:www": "wrangler deploy --config workers/www-redirect/wrangler.jsonc"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "lucide-react": "^1.52.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-leaflet": "^5.0.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.149.0"
  }
}
