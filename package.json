{
  "name": "wewillfind-it",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run images && next dev",
    "build": "npm run images && next build",
    "start": "next start",
    "lint": "eslint",
    "images": "node scripts/sync-images.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p worker",
    "dev:api": "wrangler dev --env dev --local-upstream localhost:8787",
    "cf-typegen": "wrangler types worker/worker-configuration.d.ts --env dev --strict-vars false",
    "db:schema": "node scripts/auth-schema.mjs",
    "db:migrate:local": "wrangler d1 migrations apply DB --env dev --local",
    "db:migrate:dev": "wrangler d1 migrations apply DB --env dev --remote",
    "db:migrate:prod": "wrangler d1 migrations apply DB --env prod --remote",
    "build:dev": "node scripts/build-static.mjs dev",
    "build:prod": "node scripts/build-static.mjs prod",
    "preview": "npm run dev:api",
    "deploy:dev": "npm run build:dev && wrangler deploy --env dev",
    "deploy:prod": "npm run build:prod && wrangler deploy --env prod",
    "deploy:www": "wrangler deploy --config workers/www-redirect/wrangler.jsonc"
  },
  "dependencies": {
    "better-auth": "^1.7.7",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.52.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-leaflet": "^5.0.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.149.0"
  }
}
